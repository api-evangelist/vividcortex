        {
          "id": "be0d6cee-bed1-48be-b59f-d2e67cfe7dd7",
          "name": "Fetch metric time-series data",
          "request": {
            "name": "Fetch metric time-series data",
            "description": {
              "content": "Return interpolated time-series values for one or more metrics over a time range. Also used for \"top-N\" ranked queries via `rank=1` and a metric template pattern.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "metrics",
                "series"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<integer>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<integer>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "host",
                  "value": "<string>",
                  "description": "Host ID(s), single or comma-separated."
                },
                {
                  "disabled": false,
                  "key": "metrics",
                  "value": "<string>",
                  "description": "Metric name(s) or template pattern (e.g. `host.queries.*.*.time_us`)."
                },
                {
                  "disabled": false,
                  "key": "samplesize",
                  "value": "<integer>",
                  "description": "Data resolution in seconds; must be a factor of 60."
                },
                {
                  "disabled": false,
                  "key": "separatehosts",
                  "value": "<integer>",
                  "description": "Set to 1 to split the response by host."
                },
                {
                  "disabled": false,
                  "key": "rank",
                  "value": "<integer>",
                  "description": "Set to 1 for descending order by sum value (top-N)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of series to return."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
